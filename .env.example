# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# Node & Execution Settings
NODE_ENV=production
N8N_LOG_LEVEL=info
N8N_UNVERIFIED_PACKAGES_ENABLED=true

# Optional: Add your custom encryption key here if migrating or persisting securely
# N8N_ENCRYPTION_KEY=
