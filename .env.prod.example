# ==========================================
# n8n Production Environment (Oracle Cloud)
# ==========================================

# Your public domain pointing to your Oracle Cloud VM IP (e.g. n8n.yourdomain.com or your-subdomain.duckdns.org)
DOMAIN_NAME=n8n.example.com

# Email used for Let's Encrypt SSL certificate registration & renewal notices
SSL_EMAIL=shivamjpatil2007example.com

# Timezone for workflow scheduling
GENERIC_TIMEZONE=Asia/Kolkata

# Node environment
NODE_ENV=production

# Logging level (debug, info, warn, error)
N8N_LOG_LEVEL=info

# Optional: Set a fixed 32+ character encryption key (recommended for backups & migrations)
# N8N_ENCRYPTION_KEY=
