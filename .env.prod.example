# ==========================================
# n8n Production Environment (Oracle Cloud)
# ==========================================

# Choose ONE of the free domain options below:
# -------------------------------------------------------------
# Option A (Instant - ZERO SIGNUP): Just replace with your Oracle VM Public IP!
# e.g., if Oracle IP is 140.238.150.80 -> DOMAIN_NAME=140.238.150.80.sslip.io
#
# Option B (Free Custom Name via DuckDNS.org):
# e.g., DOMAIN_NAME=shivam-n8n.duckdns.org
# -------------------------------------------------------------
DOMAIN_NAME=YOUR_ORACLE_IP.sslip.io

# Your email for automatic Let's Encrypt SSL certificates
SSL_EMAIL=shivamjpatil2007@gmail.com

# Timezone for workflow scheduling
GENERIC_TIMEZONE=Asia/Kolkata

# Node environment
NODE_ENV=production

# Logging level (debug, info, warn, error)
N8N_LOG_LEVEL=info

# Optional: Set a fixed 32+ character encryption key (recommended for backups & migrations)
# N8N_ENCRYPTION_KEY=
